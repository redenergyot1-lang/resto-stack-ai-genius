# ---------------------------------------------------------------------------
# Supabase / backend configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from YOUR Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# VITE_SUPABASE_URL              Project URL, e.g. https://abcd1234.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY  The publishable / anon key (safe in the browser,
#                                data is protected by Row Level Security)
# VITE_SUPABASE_PROJECT_ID       The project ref (the subdomain of the URL)
#
# These are read at build time by src/integrations/supabase/client.ts.
# Never put the service_role key here — it must never reach the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# The client ID / secret are NOT set here — they are configured server-side in
# your Supabase project so the secret never ships to the browser:
#   Supabase Dashboard -> Authentication -> Providers -> Google
#     Client ID:     <from Google Cloud Console>
#     Client Secret: <from Google Cloud Console>
#   Callback URL to paste into Google Cloud Console:
#     https://<your-project-ref>.supabase.co/auth/v1/callback
#
# Also add your app origins under
#   Authentication -> URL Configuration -> Site URL / Redirect URLs
# including: http://localhost:8080/auth/callback and
#            https://<your-domain>/auth/callback

# ---------------------------------------------------------------------------
# Legacy Express API (optional, unused by the current app)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api
