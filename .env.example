# Base URL for the Express API in /server. The frontend currently runs
# entirely on mock data / localStorage (see README.md and
# server/README.md "Connecting the frontend"), so this is not required
# for the app to work today — it's here for when src/services/api.js gets
# wired into AuthContext, CartContext, etc.
VITE_API_URL=http://localhost:4000/api
